# Copier ce fichier en .env et remplir les valeurs (voir README.md)

# Supabase > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Google Cloud > Identifiants > ID client OAuth
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=yyyy.apps.googleusercontent.com
# = l'ID client iOS "à l'envers" : com.googleusercontent.apps.yyyy
GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.yyyy


# Identifiants de l'appli sur les stores (doivent être uniques au monde)
IOS_BUNDLE_ID=com.littlehorse.proutmap
ANDROID_PACKAGE=com.littlehorse.proutmap

# Rempli après `npx eas-cli@latest init`
EAS_PROJECT_ID=
